@model List<RaceDay.Web.DTOs.EventDto>

@{
    ViewData["Title"] = "Organiser Dashboard";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="bi bi-speedometer2" style="color: #e94560;"></i> Organiser Dashboard</h2>
    <a asp-action="CreateEvent" class="btn text-white" style="background: #e94560;">
        <i class="bi bi-plus-circle"></i> Create New Event
    </a>
</div>

<div class="card shadow-sm border-0">
    <div class="card-body">
        <h5 class="card-title mb-3">Your Events</h5>
        
        @if (Model != null && Model.Any())
        {
            <table class="table table-hover align-middle">
                <thead>
                    <tr>
                        <th>Event Name</th>
                        <th>Date</th>
                        <th>Location</th>
                        <th>Type</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var ev in Model)
                    {
                        <tr>
                            <td>@ev.Name</td>
                            <td>@ev.EventDate.ToString("dd MMM yyyy")</td>
                            <td>@ev.Location</td>
                            <td><span class="badge bg-primary">@ev.EventType</span></td>
                            <td>
                                <a asp-action="ManageCategories" asp-route-eventId="@ev.EventId" class="btn btn-sm btn-outline-primary">
                                    <i class="bi bi-tags"></i> Categories
                                </a>
                                <a asp-action="ViewEnrolments" asp-route-eventId="@ev.EventId" class="btn btn-sm btn-outline-info ms-1">
                                    <i class="bi bi-people"></i> Enrolments
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <p class="text-muted">You haven't created any events yet. Click "Create New Event" to get started.</p>
        }
    </div>
</div>