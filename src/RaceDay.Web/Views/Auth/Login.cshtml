@model RaceDay.Web.DTOs.LoginDto

@{
    ViewData["Title"] = "Login - RaceDay";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-5">
        <div class="card shadow-sm border-0">
            <div class="card-body p-5">
                <h2 class="text-center mb-4" style="color: #e94560;">
                    <i class="bi bi-box-arrow-in-right"></i> Login
                </h2>

                @if (!string.IsNullOrEmpty(ViewBag.Error))
                {
                    <div class="alert alert-danger">@ViewBag.Error</div>
                }

                <form asp-action="Login" method="post">
                    <div class="mb-3">
                        <label asp-for="Email" class="form-label">Email Address</label>
                        <input asp-for="Email" class="form-control" type="email" placeholder="your@email.com" required />
                    </div>

                    <div class="mb-4">
                        <label asp-for="Password" class="form-label">Password</label>
                        <input asp-for="Password" class="form-control" type="password" placeholder="••••••••" required />
                    </div>

                    <button type="submit" class="btn btn-primary w-100 btn-lg">
                        Login
                    </button>
                </form>

                <hr class="my-4" />

                <p class="text-center mb-0">
                    Don't have an account? <a asp-action="Register" style="color: #e94560;">Register here</a>
                </p>
            </div>
        </div>
    </div>
</div>